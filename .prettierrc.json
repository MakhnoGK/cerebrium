{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrderParserPlugins": ["typescript", "decorators-legacy"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^@/domain(/.*)?$",
    "^@/application(/.*)?$",
    "^@/(db|code|embeddings|consolidation|runtime)/(.*)$",
    "^@/(core|presentation|tools)/(.*)$",
    "^@/(.*)$",
    "^@test/(.*)$",
    "^[./]"
  ]
}
