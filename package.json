{
  "name": "cerebrium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DB-as-source-of-truth memory system for AI agents (MCP server, stdio)",
  "license": "MIT",
  "author": "Hryhorii Khyzhniakov",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "cerebrium": "dist/server.js",
    "cerebrium-daemon": "dist/daemon.js",
    "cerebrium-runner": "dist/runner.js",
    "cerebrium-stats": "dist/stats-cli.js",
    "cerebrium-service": "dist/service-cli.js"
  },
  "scripts": {
    "build": "npm run build:bins && npm run build:plugin && npm run build:dashboard",
    "build:bins": "tsup && node scripts/copy-assets.mjs",
    "build:plugin": "tsup --config apps/plugin/tsup.config.ts",
    "build:dashboard": "vite build --config apps/dashboard-web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/dashboard-web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run smoke:scripts && npm run build && npm run smoke:bundle",
    "dev": "CEREBRIUM_HOME=.tmp/dev node dist/server.js",
    "dev:dashboard": "vite --config apps/dashboard-web/vite.config.ts",
    "daemon": "mkdir -p .tmp/dev && CEREBRIUM_HOME=.tmp/dev MEMORY_PG_URL=postgres://cerebrium:cerebrium@localhost:55432/cerebrium node dist/daemon.js",
    "stats": "CEREBRIUM_HOME=.tmp/dev MEMORY_PG_URL=postgres://cerebrium:cerebrium@localhost:55432/cerebrium node dist/stats-cli.js",
    "service": "tsx apps/host/src/service-cli.ts",
    "agent:setup": "vite-node --config vitest.config.ts apps/plugin/scripts/agent-setup.mts",
    "smoke:bundle": "npm run agent:setup -- --verify > /dev/null",
    "eval:retrieval": "vite-node --config vitest.config.ts packages/kernel/scripts/eval-retrieval.mts",
    "eval:agents": "vite-node --config vitest.config.ts apps/plugin/scripts/agent-trace-audit.ts",
    "calibrate:report": "vite-node --config vitest.config.ts packages/kernel/scripts/calibration-report.mts",
    "report:readloop": "vite-node --config vitest.config.ts packages/kernel/scripts/read-loop-report.ts",
    "report:lint": "vite-node --config vitest.config.ts packages/kernel/scripts/lint-report.mts",
    "gold:generate": "vite-node --config vitest.config.ts packages/kernel/scripts/gold-generate.mts",
    "gold:adjudicate": "vite-node --config vitest.config.ts packages/kernel/scripts/gold-adjudicate.mts",
    "smoke:scripts": "npm run service -- --help > /dev/null && npm run agent:setup -- --help > /dev/null && npm run eval:agents -- --help > /dev/null && npm run eval:retrieval -- --help > /dev/null && npm run calibrate:report -- --help > /dev/null && npm run report:readloop -- --help > /dev/null && npm run report:lint -- --help > /dev/null && npm run eval:encoding -- --help > /dev/null && npm run eval:embedding -- --help > /dev/null && npm run eval:roles -- --help > /dev/null && npm run gold:generate -- --help > /dev/null && npm run gold:adjudicate -- --help > /dev/null && npm run space:build -- --help > /dev/null && npm run space:report -- --help > /dev/null",
    "inspect": "CEREBRIUM_HOME=.tmp/dev npx @modelcontextprotocol/inspector node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/e2e/**'",
    "test:e2e": "vitest run packages/kernel/test/e2e",
    "pg:up": "sh scripts/pg-dev.sh up",
    "pg:down": "sh scripts/pg-dev.sh down",
    "test:watch": "vitest",
    "eval:encoding": "vite-node --config vitest.config.ts packages/kernel/scripts/eval-encoding.mts",
    "eval:embedding": "vite-node --config vitest.config.ts packages/kernel/scripts/embed-agreement.mts",
    "space:build": "vite-node --config vitest.config.ts packages/kernel/scripts/space-build.mts",
    "space:report": "vite-node --config vitest.config.ts packages/kernel/scripts/space-report.mts",
    "eval:roles": "vite-node --config vitest.config.ts packages/kernel/scripts/role-agreement.mts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@swc/core": "^1.15.46",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typebox": "^1.3.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
